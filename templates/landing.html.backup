{% extends "base.html" %}

{% block title %}Spendly — Track Every Rupee{% endblock %}

{% block content %}

<section class="hero">
    <div class="hero-content">
        <!-- Top Badge -->
        <div class="hero-badge">
            <span class="badge-dot"></span>
            <span class="badge-text">Free to use · No credit card needed</span>
        </div>

        <!-- Main Hero Headline -->
        <h1 class="hero-title">
            Track every rupee.<br>
            <span class="hero-title-green">Know where it goes.</span>
        </h1>

        <!-- Description -->
        <p class="hero-description">
            Spendly helps you log expenses, spot patterns, and stay<br>
            on budget — without the spreadsheet headache.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-actions">
            <a href="{{ url_for('register') }}" class="btn-primary">Create free account</a>
            <a href="{{ url_for('login') }}" class="btn-secondary">See how it works</a>
        </div>
    </div>

    <!-- Dashboard Preview Card -->
    <div class="dashboard-preview">
        <!-- Window Controls -->
        <div class="dashboard-header">
            <span class="window-dot window-dot-red"></span>
            <span class="window-dot window-dot-yellow"></span>
            <span class="window-dot window-dot-green"></span>
        </div>

        <!-- Summary Cards -->
        <div class="dashboard-summary">
            <div class="summary-card">
                <h3 class="summary-title">This month</h3>
                <p class="summary-value">₹18,240</p>
                <p class="summary-indicator summary-negative">+12% vs last</p>
            </div>
            <div class="summary-card">
                <h3 class="summary-title">Budget left</h3>
                <p class="summary-value">₹6,760</p>
                <p class="summary-indicator summary-positive">43% remaining</p>
            </div>
            <div class="summary-card">
                <h3 class="summary-title">Transactions</h3>
                <p class="summary-value">34</p>
                <p class="summary-indicator summary-neutral">this month</p>
            </div>
        </div>

        <!-- Expense Category Progress -->
        <div class="dashboard-progress">
            <div class="progress-row">
                <label class="progress-label">Food</label>
                <div class="progress-track">
                    <div class="progress-fill progress-fill-food" style="width: 74%"></div>
                </div>
            </div>
            <div class="progress-row">
                <label class="progress-label">Travel</label>
                <div class="progress-track">
                    <div class="progress-fill progress-fill-travel" style="width: 49%"></div>
                </div>
            </div>
            <div class="progress-row">
                <label class="progress-label">Bills</label>
                <div class="progress-track">
                    <div class="progress-fill progress-fill-bills" style="width: 39%"></div>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}